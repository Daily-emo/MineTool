# Cloudflare Pages 响应头
# 注意：Cloudflare Pages 默认给 /public 下的文件 max-age=0, must-revalidate，
# 意味着每次访问都要跟边缘节点重新校验一轮 -- 这才是二次访问慢的主因。

# 构建产物带指纹，永久缓存
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 图片：30 天内不再回源校验。若以后替换同名图片，老访客最多 30 天看旧图，
# 需要立刻生效就把文件名一起改（例如 FirPE.webp -> FirPE-v2.webp）并改成 immutable。
/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# 数据文件：缓存 10 分钟，期间用本地副本，过期后用旧的先渲染再后台更新
/json/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400
